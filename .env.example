# Clerk public key used by the renderer.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Optional custom auth callback. Defaults are handled by the app if omitted.
VITE_CLERK_AUTH_CALLBACK_URL=paperite://auth/callback

# Google OAuth desktop client for Google Drive sync.
# Google calls this a secret, but installed-app clients are public by design.
PAPERITE_GOOGLE_CLIENT_ID=your_google_desktop_oauth_client_id.apps.googleusercontent.com
PAPERITE_GOOGLE_CLIENT_SECRET=your_google_desktop_oauth_client_secret

# Convex public deployment URL for shared/collaborative spaces.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk issuer domain used by Convex auth config.
# Also set this in the Convex dashboard environment variables.
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer.clerk.accounts.dev
