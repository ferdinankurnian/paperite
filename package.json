{
	"name": "paperite",
	"private": true,
	"version": "0.0.0",
	"main": "main.js",
	"scripts": {
		"start": "bun run dev",
		"dev": "concurrently -k \"bun run dev:web\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
		"dev:web": "vite",
		"build": "tsc -b && vite build",
		"lint": "biome check .",
		"preview": "vite preview",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.2.9",
		"@fontsource/courgette": "^5.2.7",
		"@tanstack/react-router": "^1.170.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.16.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"shadcn": "^4.7.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "latest"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@tailwindcss/vite": "latest",
		"@tanstack/router-plugin": "^1.168.6",
		"@types/node": "^24.12.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"electron": "^42.1.0",
		"concurrently": "^9.2.1",
		"tailwindcss": "latest",
		"typescript": "~6.0.2",
		"wait-on": "^9.0.3",
		"vite": "^8.0.12"
	},
	"packageManager": "bun@1"
}
