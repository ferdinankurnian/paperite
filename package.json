{
  "name": "paperite",
  "author": {
    "name": "Ferdinan Iydheko",
    "email": "ferdinankurnian@gmail.com"
  },
  "description": "A note-taking app",
  "private": true,
  "version": "0.2.0",
  "main": "main.js",
  "desktopName": "dev.iydheko.paperite",
  "build": {
    "appId": "dev.iydheko.paperite",
    "productName": "Paperite",
    "icon": "public/paperiteicon-dark.png",
    "files": [
      "main.js",
      "preload.js",
      "dist/index.html",
      "dist/popout.html",
      "dist/assets/**/*",
      "dist/*.png",
      "dist/*.svg",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Paperite",
        "schemes": [
          "paperite"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility",
      "syncDesktopName": true
    }
  },
  "scripts": {
    "dev": "concurrently -k \"bun run dev:web\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:macos": "IS_MACOS=1 bun run dev",
    "dev:web": "vite",
    "dev:server": "PAPERITE_WEB=1 concurrently -k \"bun run dev:web\" \"wait-on http://localhost:5173 && node server/index.js --dev\"",
    "web": "node server/index.js",
    "build": "tsc -b && vite build && electron-builder --publish never",
    "lint": "biome check .",
    "preview": "vite preview",
    "format": "biome format --write .",
    "convex:dev": "convex dev",
    "doctor": "npx react-doctor@latest",
    "test": "bun test"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/courgette": "^5.2.7",
    "@tanstack/react-router": "^1.170.4",
    "@tiptap/core": "3.26.0",
    "@tiptap/extension-collaboration": "3.26.0",
    "@tiptap/extension-color": "^3.26.0",
    "@tiptap/extension-highlight": "^3.26.0",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-task-item": "3.26.0",
    "@tiptap/extension-task-list": "3.26.0",
    "@tiptap/extension-text-align": "3.26.0",
    "@tiptap/extension-text-style": "^3.26.0",
    "@tiptap/extension-underline": "3.26.0",
    "@tiptap/pm": "3.26.0",
    "@tiptap/react": "3.26.0",
    "@tiptap/starter-kit": "3.26.0",
    "@tiptap/suggestion": "^3.26.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.41.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "keytar": "^7.9.0",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0",
    "yjs": "^13.6.31",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@tailwindcss/vite": "latest",
    "@tanstack/router-plugin": "^1.168.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.15.2",
    "react-doctor": "^0.9.2",
    "react-scan": "^0.5.7",
    "tailwindcss": "latest",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.3"
  },
  "packageManager": "bun@1.3.13"
}
